{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lanes",
  "version": "0.1.0",
  "identifier": "dev.lanes.app",
  "build": {
    "beforeDevCommand": "pnpm --filter lanes-ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter lanes-ui build",
    "frontendDist": "../ui/dist",
    "beforeBundleCommand": "pnpm -w run sign:dlls"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Lanes Project",
    "copyright": "Copyright (c) 2026 Lanes Project",
    "shortDescription": "Lightweight game capture and clipping",
    "category": "Video",
    "windows": {
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/sign.ps1 %1",
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../third_party/ffmpeg/bin/avcodec-63.dll": "./",
      "../third_party/ffmpeg/bin/avformat-63.dll": "./",
      "../third_party/ffmpeg/bin/avutil-61.dll": "./",
      "../third_party/ffmpeg/bin/swresample-7.dll": "./",
      "../third_party/ffmpeg/LICENSE.txt": "FFmpeg-LICENSE.txt"
    }
  }
}
